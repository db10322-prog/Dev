# === 본체 AI ===
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# === 서브 에이전트 ===
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
GOOGLE_FACTCHECK_API_KEY=

# === 캐시 백엔드: local(기본, 오프라인 데모용) | supabase(클라우드 배포용) ===
CACHE_BACKEND=local

# === Supabase (클라우드 배포/Vercel 모드에서만 필요) ===
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# 브라우저/확장에 노출해도 되는 키는 anon 키만. 서비스 롤 키는 서버(Vercel)에서만 사용.
SUPABASE_ANON_KEY=

# === 네이티브 메시징 브릿지 ===
NATIVE_HOST_HTTP_PORT=5757
NATIVE_HOST_NAME=com.fakenewsagent.host
