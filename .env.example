# === 본체 AI ===
# 기본값(권장): 아래 둘 다 비워두면 core/agents/localLlm.js가 로컬 모델(Qwen2.5-3B, node-llama-cpp)을
# 사용합니다. 계정/로그인/이용약관 동의가 전혀 필요 없음 — 먼저 `npm run download-model` 실행할 것.
# Gemini/Groq는 둘 다 이용약관상 만 18세 이상만 가입 가능한 서비스라, 성인(부모님/선생님 등)이
# 대신 발급해준 키가 있을 때만 아래에 채우세요. 없으면 그냥 비워두면 됩니다 — 로컬 모델로 잘 동작합니다.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# === 서브 에이전트 ===
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
# 선택 사항. 비워두면 core/agents/factCheck.js가 네이버 뉴스 보조 쿼리로 자동 폴백합니다.
# (Google Cloud Console 프로젝트 생성이 필요해 번거로우면 그냥 생략해도 됨.)
GOOGLE_FACTCHECK_API_KEY=

# === 캐시 백엔드: local(기본, 오프라인 데모용) | supabase(클라우드 배포용) ===
CACHE_BACKEND=local

# === Supabase (클라우드 배포/Vercel 모드에서만 필요) ===
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# 브라우저/확장에 노출해도 되는 키는 anon 키만. 서비스 롤 키는 서버(Vercel)에서만 사용.
SUPABASE_ANON_KEY=

# === 네이티브 메시징 브릿지 ===
NATIVE_HOST_HTTP_PORT=5757
NATIVE_HOST_NAME=com.fakenewsagent.host
