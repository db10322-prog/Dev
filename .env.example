# === 본체 AI ===
# 우선순위: MISTRAL_API_KEY > HF_API_KEY > GEMINI_API_KEY > GROQ_API_KEY > 로컬 모델(전부 비어있으면 자동 사용).
#
# 추천(무료 & 미성년자도 직접 가입 가능): Mistral AI — https://console.mistral.ai/
#   이용약관상 만 13세 이상, 미성년자는 보호자 동의로 본인 명의 가입 가능(카드 불필요, SMS 인증만).
#   무료 "Experiment" 티어가 Mistral Large(로컬 1.5B보다 품질 훨씬 좋음)를 월 10억 토큰까지 무료 제공.
#   단, 이 SMS 인증 자체를 지금 당장 할 수 없는 상황(휴대폰이 없음/제출됨 등)이면 미인증 기본
#   한도가 매우 낮아 거의 못 쓴다 — 그럴 땐 아래 HF_API_KEY를 대신 채울 것.
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-large-latest

# 휴대폰 인증이 가능한 상황이라면 Mistral 다음으로 품질 좋은 대안: DeepSeek(공식)
# — https://platform.deepseek.com/api_keys
#   이용약관상 "만 18세 미만은 보호자 동의하에 이용"으로 Mistral과 같은 구조(Gemini/Groq처럼
#   딱 잘라 18세 이상만 되는 게 아님). 단 가입 시 SMS 인증 필수. 신규 계정에 소량의 무료
#   크레딧을 줘서 카드 없이도 당장 몇 번은 호출 가능(금액/기간은 자주 바뀌니 가입 후 대시보드
#   에서 직접 확인). 크레딧 소진 후엔 카드 등록 없이는 더 못 씀.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# 전화번호도 카드도 필요 없는 대안 중 무료 한도가 가장 넉넉함: Z.ai(GLM, 국제 포털)
# — https://z.ai/manage-apikey/apikey-list (이메일 가입만으로 끝)
#   약관 전체에 나이 하한선 자체가 없음(직접 확인함 — "13세 미만 개인정보 처리 금지"라는
#   COPPA 관련 한 줄만 있고 이용 자격과는 무관). glm-4.5-flash가 상시 무료, 하루 약 1000건 수준.
ZAI_API_KEY=
ZAI_MODEL=glm-4.5-flash

# 전화번호 인증도, 카드 등록도 전혀 필요 없는 대안: Hugging Face — https://huggingface.co/settings/tokens
#   이용약관상 만 13세 이상, 이메일 가입 + 토큰 발급(재생성 가능한 fine-grained 토큰, "Make calls to
#   Inference Providers" 권한 체크)만으로 끝. 대신 무료 크레딧이 월 $0.10로 매우 적어서 상시 운영보다는
#   임시 대안에 가까움(https://hf.co/settings/inference-providers 에서 남은 크레딧 확인 가능).
HF_API_KEY=
HF_MODEL=meta-llama/Llama-3.3-70B-Instruct:cheapest

# 또 다른 카드/전화번호 불필요 대안: SambaNova Cloud — https://cloud.sambanova.ai/
#   이용약관·EULA에 최소 연령 조항 자체가 없음(직접 확인함). 이메일 가입만으로 끝. 대신 무료 티어가
#   분당 20건 + 일일 20건으로 낮아서(이 파이프라인은 판정 1건당 보통 2번 호출) 하루 10건 안팎만 가능.
SAMBANOVA_API_KEY=
SAMBANOVA_MODEL=Meta-Llama-3.3-70B-Instruct

# Gemini/Groq는 둘 다 이용약관상 만 18세 이상만 가입 가능한 서비스라, 성인(부모님/선생님 등)이
# 대신 발급해준 키가 있을 때만 아래에 채우세요. 전부 비워두면 core/agents/localLlm.js가 로컬 모델
# (Qwen2.5-1.5B, node-llama-cpp)을 자동으로 씁니다 — 계정/로그인/이용약관 동의 전혀 필요 없음
# (먼저 `npm run download-model` 실행할 것).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# === 서브 에이전트 ===
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
# 선택 사항. 비워두면 core/agents/factCheck.js가 네이버 뉴스 보조 쿼리로 자동 폴백합니다.
# (Google Cloud Console 프로젝트 생성이 필요해 번거로우면 그냥 생략해도 됨.)
GOOGLE_FACTCHECK_API_KEY=

# === 캐시 백엔드: local(기본, 오프라인 데모용) | supabase(클라우드 배포용) ===
CACHE_BACKEND=local

# === Supabase (클라우드 배포/Vercel 모드에서만 필요) ===
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# 브라우저/확장에 노출해도 되는 키는 anon 키만. 서비스 롤 키는 서버(Vercel)에서만 사용.
SUPABASE_ANON_KEY=

# === 네이티브 메시징 브릿지 ===
NATIVE_HOST_HTTP_PORT=5757
NATIVE_HOST_NAME=com.fakenewsagent.host
