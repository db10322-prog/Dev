{
  "name": "fake-news-agent",
  "version": "0.1.0",
  "private": true,
  "description": "뉴스 진위/편향 판별 AI 에이전트 — 크롬 확장 + Electron 캐릭터 오버레이 + Vercel/Supabase 클라우드 모드",
  "main": "app/main.js",
  "scripts": {
    "start": "electron .",
    "cli": "node cli.js",
    "spike:naver": "node spike/naver_news.js",
    "spike:gemini": "node spike/gemini_json.js",
    "spike:factcheck": "node spike/factcheck_ko.js",
    "preload:demo": "node scripts/preload-demo.js",
    "eval": "node eval/run.js",
    "register-host": "powershell -ExecutionPolicy Bypass -File installer/register-host.ps1",
    "download-model": "node scripts/download-model.js",
    "spike:local-llm": "node spike/local_llm_json.js",
    "spike:mistral": "node spike/mistral_json.js"
  },
  "dependencies": {
    "@mozilla/readability": "^0.5.0",
    "@supabase/supabase-js": "^2.45.4",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsdom": "^24.1.3",
    "node-fetch": "^2.7.0",
    "node-llama-cpp": "^3.20.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "electron": "^31.3.0",
    "electron-builder": "^24.13.3"
  },
  "author": "",
  "license": "UNLICENSED",
  "allowScripts": {
    "electron@31.7.7": true,
    "node-llama-cpp@3.20.0": true
  },
  "build": {
    "appId": "com.fakenewsagent.app",
    "productName": "뉴스 판별 에이전트",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "app/**/*",
      "core/**/*",
      "data/**/*",
      "native-host/**/*",
      "installer/**/*",
      "scripts/**/*",
      "cli.js",
      "package.json",
      "node_modules/**/*",
      "!node_modules/@node-llama-cpp/win-arm64/**",
      "!node_modules/@node-llama-cpp/win-x64-cuda/**",
      "!node_modules/@node-llama-cpp/win-x64-cuda-ext/**",
      "!node_modules/@node-llama-cpp/win-x64-vulkan/**",
      "!**/*.md",
      "!spike/**",
      "!eval/**",
      "!web/**",
      "!models/**",
      "!cache/**",
      "!.git/**"
    ],
    "win": {
      "target": "portable",
      "icon": "app/character/app-icon.png",
      "signAndEditExecutable": false,
      "verifyUpdateCodeSignature": false,
      "artifactName": "NewsVerdictAgent-Setup.exe"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "artifactName": "뉴스판별에이전트-설치.exe"
    }
  }
}
